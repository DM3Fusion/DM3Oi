# Public values from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never prefix this credential with NEXT_PUBLIC_.
DM3IQCM_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical base URL used for invitation callbacks.
DM3IQCM_SITE_URL=https://dm-3i-qcm.vercel.app

# Server-only canonical origin used in operational email links.
DM3IQCM_APP_URL=https://dm-3i-qcm.vercel.app

# Server-only Fastmail SMTP transport for operational email delivery.
DM3IQCM_SMTP_HOST=smtp.fastmail.com
DM3IQCM_SMTP_PORT=465
DM3IQCM_SMTP_SECURE=true
DM3IQCM_SMTP_USER=your-fastmail-login
DM3IQCM_SMTP_PASSWORD=your-fastmail-app-password
DM3IQCM_SMTP_FROM_EMAIL=notifications@example.com
DM3IQCM_SMTP_FROM_NAME=DM3Oi
